    "conditions": {
      "adr": {
        "en": "Daily range vs ADR",
        "fr": "Range journalier vs ADR"
      }
    },
    "outcomes": {
      "exceeded": {
        "en": "Exceeded ADR",
        "fr": "A dépassé l'ADR"
      },
      "respected": {
        "en": "Respected ADR",
        "fr": "A respecté l'ADR"
      }
    },
    "dimensions": {
      "weekday": {
        "en": "Day of week",
        "fr": "Jour de la semaine"
      }
    }
  },
