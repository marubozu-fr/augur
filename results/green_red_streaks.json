{
  "stat_name": "green_red_streaks",
  "title": {
    "en": "Green & Red Streaks",
    "fr": "Séries vertes et rouges"
  },
  "definition": {
    "en": "Once a period is green (or red), how likely is the streak to continue for one more period of the same color?",
