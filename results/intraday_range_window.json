{
  "stat_name": "intraday_range_window",
  "title": {
    "en": "Intraday Range Window",
    "fr": "Amplitude d'une fenêtre intraday"
  },
  "definition": {
    "en": "The high-low range over a configurable intraday window measured each day, summarized across days. Reports the average, maximum, minimum, and median of both the absolute range (points) and the percentage range.",
    "fr": "L'amplitude haut-bas sur une fenêtre intraday configurable mesurée chaque jour, résumée sur l'ensemble des jours. Donne la moyenne, le maximum, le minimum et la médiane de l'amplitude en points et de l'amplitude en pourcentage."
  },
  "labels": {
    "conditions": {
      "0930-1030": {
        "en": "09:30–10:30",
        "fr": "09:30–10:30"
      }
    },
    "outcomes": {
      "range_avg": {
        "en": "Average range (points)",
        "fr": "Amplitude moyenne (points)"
      },
      "range_max": {
        "en": "Maximum range (points)",
        "fr": "Amplitude maximale (points)"
      },
      "range_min": {
        "en": "Minimum range (points)",
        "fr": "Amplitude minimale (points)"
      },
      "range_median": {
        "en": "Median range (points)",
        "fr": "Amplitude médiane (points)"
      },
      "range_pct_avg": {
        "en": "Average range (%)",
        "fr": "Amplitude moyenne (%)"
      },
      "range_pct_max": {
        "en": "Maximum range (%)",
        "fr": "Amplitude maximale (%)"
      },
      "range_pct_min": {
        "en": "Minimum range (%)",
        "fr": "Amplitude minimale (%)"
      },
      "range_pct_median": {
        "en": "Median range (%)",
        "fr": "Amplitude médiane (%)"
      }
    },
    "dimensions": {
      "weekday": {
        "en": "Day of week",
        "fr": "Jour de la semaine"
      }
    }
  },
