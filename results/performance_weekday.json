      "mean_return": {
        "en": "Average return",
        "fr": "Rendement moyen"
      },
      "green_day": {
        "en": "Green day (up)",
        "fr": "Jour vert (hausse)"
      },
      "red_day": {
        "en": "Red day (down)",
        "fr": "Jour rouge (baisse)"
      },
      "mean_green_move": {
        "en": "Average green move",
        "fr": "Mouvement vert moyen"
      },
      "mean_red_move": {
        "en": "Average red move",
        "fr": "Mouvement rouge moyen"
      }
    },
    "dimensions": {
      "weekday": {
        "en": "Day of week",
        "fr": "Jour de la semaine"
      }
    }
  },
