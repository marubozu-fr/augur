{
  "stat_name": "daily_high_low_session",
  "title": {
    "en": "Daily High / Low Session",
    "fr": "Session du plus haut / plus bas journalier"
  },
  "definition": {
    "en": "For each trading cycle, which intraday market session produced the day's highest high and which produced the day's lowest low? Reported as a probability distribution over the configured sessions; probabilities sum to 1 within each condition.",
    "fr": "Pour chaque cycle de trading, quelle session de marché intrajournalière a produit le plus haut du jour et laquelle a produit le plus bas du jour ? Présenté comme une distribution de probabilité sur les sessions configurées ; les probabilités somment à 1 par condition."
  },
  "labels": {
    "conditions": {
      "daily_high": {
        "en": "Day's high",
        "fr": "Plus haut du jour"
      },
      "daily_low": {
        "en": "Day's low",
        "fr": "Plus bas du jour"
      }
    },
    "outcomes": {
      "asia": {
        "en": "Asia",
        "fr": "Asie"
      },
      "london": {
        "en": "London",
        "fr": "Londres"
      },
      "ny": {
        "en": "New York",
        "fr": "New York"
      }
    },
    "dimensions": {
      "weekday": {
        "en": "Day of week",
        "fr": "Jour de la semaine"
      },
      "candle": {
        "en": "Daily candle color",
        "fr": "Couleur de la bougie journalière"
      }
    }
  },
